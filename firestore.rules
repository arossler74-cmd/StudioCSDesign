rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // These live INSIDE the match block on purpose. $(database) is bound by
    // "match /databases/{database}/documents", so a function that references it
    // has to share that scope. Declared at service level -- as they were --
    // the variable is unbound, the get() path never resolves, and every
    // isAdmin() check evaluates false no matter who is signed in. Reads that
    // did not call isAdmin() still worked, so the app could show a user as
    // ADMIN while Firestore refused every write that account attempted.
    function isSignedIn() { return request.auth != null; }
    function profile() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    // Guarded with exists(): get() on a missing document errors, and an errored
    // rule denies, which would lock out an account whose profile has not been
    // written yet rather than simply treating it as unprivileged.
    function hasProfile() { return isSignedIn() && exists(profile()); }
    function role() { return hasProfile() ? get(profile()).data.role : ''; }
    // Keep the two studio owners working during an Auth UID/profile migration.
    // The verified email check is deliberately narrow; everyone else still
    // needs an admin role on their users/{uid} profile.
    function isBootstrapAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'arossler74@gmail.com',
          'cybelle@cybellesampaio.com'
        ];
    }
    function isAdmin() { return isBootstrapAdmin() || role() == 'admin'; }
    function isMember(project) { return isSignedIn() && request.auth.uid in project.members; }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isAdmin() || (request.auth.uid == uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
      allow delete: if isAdmin();
    }

    match /invites/{id} {
      allow read, write: if isAdmin();
    }

    match /catalog/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /settings/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Public, token-scoped mirror of what a client link may show.
    // The token is a 16-char random id and is the only way in — nothing here is listable.
    match /shares/{token} {
      allow get: if true;
      allow list: if isSignedIn();
      allow write: if isSignedIn();

      // client feedback: write-only for visitors, readable by the studio
      match /reviews/{id} {
        allow create: if request.resource.data.keys().hasAll(['itemId', 'by'])
                      && request.resource.data.by is string
                      && request.resource.data.by.size() < 120
                      && (!('comment' in request.resource.data) || request.resource.data.comment.size() < 2000);
        allow read, update, delete: if isSignedIn();
      }
    }

    match /projects/{projectId} {
      allow get: if isAdmin() || isMember(resource.data);
      // list queries must be scoped: non-admins query members array-contains their uid
      allow list: if isAdmin() || (isSignedIn() && request.query.limit <= 200);
      allow create: if isAdmin() || role() == 'designer';
      allow update: if isAdmin() || isMember(resource.data);
      allow delete: if isAdmin();

      match /{sub=**} {
        allow read: if isAdmin() || isMember(get(/databases/$(database)/documents/projects/$(projectId)).data);
        allow write: if isAdmin() || (isMember(get(/databases/$(database)/documents/projects/$(projectId)).data) && role() != 'client');
      }
    }
  }
}
