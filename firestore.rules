rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // These live INSIDE the match block on purpose. $(database) is bound by
    // "match /databases/{database}/documents", so a function that references it
    // has to share that scope. Declared at service level -- as they were --
    // the variable is unbound, the get() path never resolves, and every
    // isAdmin() check evaluates false no matter who is signed in. Reads that
    // did not call isAdmin() still worked, so the app could show a user as
    // ADMIN while Firestore refused every write that account attempted.
    function isSignedIn() { return request.auth != null; }
    function profile() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    // Guarded with exists(): get() on a missing document errors, and an errored
    // rule denies, which would lock out an account whose profile has not been
    // written yet rather than simply treating it as unprivileged.
    function hasProfile() { return isSignedIn() && exists(profile()); }
    function role() { return hasProfile() ? get(profile()).data.role : ''; }
    // Keep the two studio owners working during an Auth UID/profile migration.
    // The verified email check is deliberately narrow; everyone else still
    // needs an admin role on their users/{uid} profile.
    function isBootstrapAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'arossler74@gmail.com',
          'cybellesampaio77@gmail.com'
        ];
    }
    function isAdmin() { return isBootstrapAdmin() || role() == 'admin'; }
    function isAssignedDesigner(project) {
      return isSignedIn()
        && role() == 'designer'
        && request.auth.token.email_verified == true
        && ('designerEmails' in project)
        && request.auth.token.email in project.designerEmails;
    }
    function isProjectClient(project) {
      return isSignedIn()
        && role() == 'client'
        && request.auth.token.email_verified == true
        && ('clientEmail' in project)
        && request.auth.token.email == project.clientEmail;
    }
    function canReadProject(project) {
      return isAdmin() || isAssignedDesigner(project) || isProjectClient(project);
    }
    function assignmentIsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['members', 'designerEmails', 'clientEmail']);
    }

    match /users/{uid} {
      // A client must not be able to enumerate the studio team.
      allow get: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isAdmin() || (request.auth.uid == uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
      allow delete: if isAdmin();
    }

    match /invites/{id} {
      // An invited person may read only the invite addressed to their verified
      // email, so their first login can safely receive the assigned role.
      allow get, list: if isAdmin()
        || (isSignedIn()
          && request.auth.token.email_verified == true
          && request.auth.token.email == resource.data.email);
      allow create, update, delete: if isAdmin();
    }

    match /catalog/{id} {
      allow read: if isAdmin() || role() == 'designer';
      allow write: if isAdmin();
    }

    match /settings/{doc} {
      allow read: if isAdmin() || role() == 'designer';
      allow write: if isAdmin();
    }

    // Public, token-scoped mirror of what a client link may show.
    // The token is a 16-char random id and is the only way in — nothing here is listable.
    match /shares/{token} {
      allow get: if true;
      allow list, write: if isAdmin() || role() == 'designer';

      // client feedback: write-only for visitors, readable by the studio
      match /reviews/{id} {
        allow create: if request.resource.data.keys().hasAll(['itemId', 'by'])
                      && request.resource.data.by is string
                      && request.resource.data.by.size() < 120
                      && (!('comment' in request.resource.data) || request.resource.data.comment.size() < 2000);
        allow read, update, delete: if isSignedIn();
      }
    }

    match /projects/{projectId} {
      allow get: if canReadProject(resource.data);
      // Firestore evaluates this per returned document, so the app's queries
      // must prove either the assigned designer or the one client email.
      allow list: if isAdmin() || (request.query.limit <= 200 && canReadProject(resource.data));
      allow create: if isAdmin();
      // Designers can change the project work, not client/staff assignment.
      allow update: if isAdmin() || (isAssignedDesigner(resource.data) && assignmentIsUnchanged());
      allow delete: if isAdmin();

      match /{sub=**} {
        allow read: if canReadProject(get(/databases/$(database)/documents/projects/$(projectId)).data);
        allow write: if isAdmin() || isAssignedDesigner(get(/databases/$(database)/documents/projects/$(projectId)).data);
      }
    }
  }
}
