{
  "functions": [
    {
      "source": "functions",
      "codebase": "default"
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "hosting-share",
    "rewrites": [
      { "source": "/s/**", "function": { "functionId": "shareLink", "region": "us-west1" } }
    ]
  }
}
